# Copy to .dev.vars (gitignored) and fill in. Locally only this file is read; in
# production set each value with `wrangler secret put <NAME>`.
#
# The store boots with the always-on demo checkout. Staff sign-in is delegated to
# the shared R5 Industries tenant identity service; configure its origin-bound key
# below after registering this site's verified domain and tenant membership.
#
# The two Worker secrets are SECRETS_KEK and AUTH_SECRET. The public tenant selector
# below is not a secret. EVERY provider key (Stripe, OpenNode,
# Lightning, Resend, Turnstile) and its config (default rail, Lightning node URLs,
# email from-address, etc.) is set in the admin dashboard — keys encrypted in the
# D1 vault, config in D1 settings. No provider env vars.
#
# `npm run provision:local` generates both secrets into .dev.vars automatically.
# Set the tenant selector separately after central tenant registration.

# ── One-click deploy hint (this is a visible LABEL, not a real secret) ──
# SECRETS_KEK and AUTH_SECRET below are MASKED, *required* fields in the "Deploy to
# Cloudflare" button, so any hint on them is hidden. This first entry's NAME shows a
# visible instruction above them for what value to use; its own value is unused (and
# keeps this field from being marked required). Locally, ignore it.
USE_A_LONG_RANDOM_STRING_FOR_SECRETS_KEK_AND_AUTH_SECRET=unused

# Key-encryption key for the D1 payment-key vault. Left EMPTY on purpose: the deploy
# form then shows a *required* field you must fill (no hidden default to accept), and
# locally an empty value keeps the vault dormant (demo-only) until you set one.
# Generate with: openssl rand -base64 32   (never goes in D1)
SECRETS_KEK=

# Signs customer account sessions and links, and optionally cache-purge requests.
# Use a DIFFERENT long random string from SECRETS_KEK.
AUTH_SECRET=

# Cloudflare Email Sending binding (optional) — only when using the 'cloudflare'
# email provider (Workers Paid plan + an onboarded sender domain). Declared in
# wrangler.jsonc as a binding, not here. Resend (the default) needs no binding —
# its API key is set in Admin → Settings → Email.

# Public tenant selector for the shared R5 Industries API. This key is bound to
# the exact website origin and never grants access by itself; authorization still
# requires an active identity session and tenant membership.
R5I_TENANT_PUBLIC_KEY=
