---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import { MAIN_SITE_LINKS, MAIN_SITE_URL } from './site';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * It renders on EVERY page, including cart, checkout, payment, account, and
 * Admin login. A broken header is a broken checkout, so keep the core controls
 * below and change their placement and styling rather than their markup.
 *
 * See CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

{/* Announcement bar. Deliberately NOT fixed: the header below is sticky, so a
    fixed bar would need the header offset by the bar's height — which varies
    as the message wraps on narrow screens. Static means it's seen on load,
    scrolls away, and costs no vertical space on mobile. */}
{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <div class="mx-auto max-w-6xl px-6 py-2 text-center text-xs font-semibold tracking-wide">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-2 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </div>
    </div>
  )
}

{/* Strip linking back to the marketing site. Plain anchors, no JS. */}
<div class="border-b border-line bg-surface text-xs">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-2">
    <a href={MAIN_SITE_URL} class="font-semibold text-neon-cyan hover:text-brand">&larr; ravecreations.art</a>
    <div class="flex items-center gap-4">
      <nav aria-label="RAVE Creations site" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-muted">
        {
          MAIN_SITE_LINKS.map((link) => (
            <a href={link.href} class="hover:text-brand">
              {link.text}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        data-festival-toggle
        aria-label="Toggle Festival Stage Glow"
        title="Toggle Festival Stage Glow"
        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-2.5 py-0.5 text-[10px] font-bold tracking-wider uppercase text-muted transition-all hover:border-brand hover:text-brand hover:shadow-[0_0_12px_rgba(255,55,213,0.35)]"
      >
        <span class="relative flex size-1.5">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand opacity-75"></span>
          <span class="relative inline-flex size-1.5 rounded-full bg-brand"></span>
        </span>
        <span class="hidden sm:inline">Festival Glow</span>
      </button>
    </div>
  </div>
</div>

<header class="rave-glass sticky top-0 z-20">
  <div class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-4">
    <a href="/" aria-label={model.storeName} class="shrink-0">
      {
        model.logo ? (
          /* An admin-uploaded logo wins; otherwise the bundled RAVE logo. Not
             lazy: the header logo is above the fold on every page. */
          <img src={model.logo.src} alt={model.logo.alt} class="h-8 max-w-48 object-contain sm:h-10" />
        ) : (
          <>
            <span class="sr-only">{model.storeName}</span>
            <span
              aria-hidden="true"
              class="block aspect-[410/166] h-10 bg-contain bg-left bg-no-repeat sm:h-12"
              style="background-image:url(/brand/rave-logo.svg)"
            />
          </>
        )
      }
    </a>
    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="ml-auto hidden flex-1 justify-end sm:flex"
    />
    {/* ml-auto pins the whole nav to the right edge of the header row, so it
        stays flush right no matter how few items a merchant has.
        min-w-0 is what lets long labels ellipsize instead of overflowing the
        page: flex items default to min-width:auto, and without it here the
        shrink stops at this level and the row grows past the viewport —
        putting min-w-0 only on the links themselves is not enough. */}
    <nav
      aria-label="Primary"
      class="ml-auto flex min-w-0 items-center gap-4 text-xs uppercase tracking-widest text-muted sm:gap-6"
    >
      <StoreNav links={model.headerLinks} />
      {/* Search input is desktop-only; give mobile a link to the search page. */}
      <a href={model.search.action} class="hover:text-brand sm:hidden">Search</a>
      {model.cart.enabled && <StoreCartControl href={model.cart.href} />}
      {model.account.enabled && <StoreAccountControl href={model.account.href} />}
    </nav>
  </div>
</header>
<div aria-hidden="true" class="h-px bg-gradient-to-r from-brand via-neon-cyan to-neon-yellow"></div>
