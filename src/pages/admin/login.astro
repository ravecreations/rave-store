---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';
import { tenantApiFetch } from '../../features/auth/tenant-api';

let error = Astro.url.searchParams.get('signin') === 'invalid'
  ? 'That sign-in link is invalid or has expired. Request a new one.'
  : '';
let sent = false;

if (Astro.locals.adminAuthenticated) return Astro.redirect('/admin', 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );

  if (!tsOk) {
    error = 'Verification failed — please try again.';
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 320) {
    error = 'Enter a valid email address.';
  } else {
    try {
      const forwarded = new Request(Astro.request.url, {
        method: 'POST',
        headers: new Headers(Astro.request.headers),
      });
      const response = await tenantApiFetch(
        forwarded,
        env,
        '/admin/v1/auth/magic-link',
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        },
      );
      sent = response.status === 202;
      if (!sent) error = response.status === 503
        ? 'Sign-in is temporarily unavailable. Please try again later.'
        : 'Unable to send a sign-in link. Please try again.';
    } catch {
      error = 'Sign-in is temporarily unavailable. Please try again later.';
    }
  }
}

---

<Layout title="Admin login">
  <div class="mx-auto max-w-sm py-10">
    <h1 class="mb-2 text-2xl font-bold">Admin sign in</h1>
    <p class="mb-6 text-sm text-gray-500">Enter your tenant account email and we’ll send a one-time sign-in link.</p>

    {
      sent && (
        <p class="mb-4 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
          If this email has access to the store, a sign-in link is on its way.
        </p>
      )
    }

    {
      Astro.locals.authServiceUnavailable && !error && (
        <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          Tenant sign-in is not configured or is temporarily unavailable.
        </p>
      )
    }

    {
      error && (
        <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          {error}
        </p>
      )
    }

    <form method="POST" action="/admin/login" class="space-y-4">
      <label class="block text-sm">
        <span class="mb-1 block font-medium">Email</span>
        <input
          type="email"
          name="email"
          required
          autofocus
          autocomplete="email"
          maxlength="320"
          class="w-full rounded-md border border-gray-200 px-3 py-2"
        />
      </label>

      <div class="flex justify-center">
        <Turnstile />
      </div>

      <button
        type="submit"
        class="w-full rounded-md bg-brand px-4 py-2.5 font-medium text-white hover:bg-brand-hover"
      >
        Email me a sign-in link
      </button>
    </form>
  </div>
</Layout>
---
