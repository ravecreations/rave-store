---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { tenantApiFetch } from '../../features/auth/tenant-api';

if (Astro.request.method !== 'POST') {
  return Astro.redirect('/admin', 303);
}

const forwarded = new Request(Astro.url, {
  method: 'POST',
  headers: new Headers({
    Cookie: Astro.request.headers.get('cookie') ?? '',
    Origin: Astro.url.origin,
  }),
});
const response = await tenantApiFetch(forwarded, env, '/admin/v1/auth/logout', {
  method: 'POST',
});
if (!response.ok) return new Response('Unable to sign out.', { status: 503 });

const headers = new Headers({
  Location: '/admin/login',
  'Cache-Control': 'private, no-store',
});
for (const cookie of response.headers.getSetCookie()) headers.append('Set-Cookie', cookie);
return new Response(null, { status: 303, headers });
---
