{
  "name": "minshop",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "types": "wrangler types",
    "build": "wrangler types && astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "bun scripts/deploy.mjs",
    "deploy:ci": "bun scripts/deploy.mjs --skip-build",
    "check": "bun run theme:sync && astro check",
    "test": "bun run theme:sync && vitest run",
    "test:watch": "vitest",
    "test:integration": "bun test/integration/reservations.mjs && bun test/integration/refunds.mjs && bun test/integration/media.mjs && bun test/integration/menus.mjs && bun test/integration/guest-access.mjs && bun test/integration/shipping.mjs && bash test/integration/d1-integration.sh",
    "test:d1": "astro build && bun run test:integration",
    "test:storefront-equivalence": "astro build && bash test/integration/storefront-baselines.sh",
    "test:storefront-contract": "vitest run test/storefront",
    "theme:check": "bun scripts/check-themes.mjs",
    "verify": "bun run theme:sync && vitest run && astro check && bun run theme:check && astro build && bun scripts/check-built-css.mjs && bun run test:integration && bun scripts/check-stripe-countries.mjs && bun run mcp:check && bun run scaffold:check",
    "verify:theme": "bun scripts/verify-theme.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./seed.sql",
    "provision:cf": "bash scripts/provision-cf.sh",
    "provision:local": "bash scripts/provision-local.sh",
    "destroy:cf": "bash scripts/destroy-cf.sh",
    "destroy:local": "bash scripts/destroy-local.sh",
    "admin:reset": "bash scripts/admin-reset.sh",
    "admin:reset:remote": "bash scripts/admin-reset.sh --remote",
    "reset:local": "bash scripts/reset.sh",
    "reset:remote": "bash scripts/reset.sh --remote",
    "mcp:dev": "wrangler dev --config mcp/wrangler.jsonc --persist-to .wrangler/state",
    "mcp:deploy": "wrangler deploy --config mcp/wrangler.jsonc",
    "mcp:check": "bash scripts/check-mcp.sh",
    "scaffold:check": "bun run --cwd create-minshop test && bun pm pack --cwd ./create-minshop --dry-run",
    "theme:sync": "bun scripts/theme-sync.mjs",
    "db:seed:storefront-states": "bash scripts/seed-storefront-states.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.8",
    "markdown-it": "^15.0.2",
    "stripe": "^23.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
